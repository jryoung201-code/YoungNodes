    "js": "default: {\n  if (node.js) {\n    const inputs = {};\n    for (const port of node.inputs || []) {\n      inputs[port.id] = await val(port.id);\n    }\n\n    const fn = new Function('sp', 'inputs', 'log', node.js);\n    await fn(sp, inputs, this.log);\n  }\n  break;\n}",
